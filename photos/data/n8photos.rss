NAME N8PH

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <avkon.hrh>
#include <appinfo.rh>

RESOURCE RSS_SIGNATURE
    {
    }

RESOURCE TBUF r_default_document_name
    {
    buf = "N8PH";
    }

RESOURCE EIK_APP_INFO
    {
    cba = R_AVKON_SOFTKEYS_EXIT;
    }

RESOURCE LOCALISABLE_APP_INFO r_photos_localisable_app_info
    {
    short_caption = "Photos";
    caption_and_icon = CAPTION_AND_ICON_INFO
        {
        caption = "Photos";
        number_of_icons = 1;
        icon_file = "\\resource\\apps\\n8photos_aif.mif";
        };
    }

RESOURCE DIALOG r_photos_rename_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_DATA_QUERY
                {
                layout = EDataLayout;
                label = "Name";
                control = EDWIN
                    {
                    width = 32;
                    maxlength = 100;
                    lines = 1;
                    };
                };
            }
        };
    }

RESOURCE DIALOG r_photos_delete_query
    {
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_YES_NO;
    items =
        {
        DLG_LINE
            {
            type = EAknCtQuery;
            id = EGeneralQuery;
            control = AVKON_CONFIRMATION_QUERY
                {
                layout = EConfirmationQueryLayout;
                label = "Delete this photo?";
                };
            }
        };
    }
